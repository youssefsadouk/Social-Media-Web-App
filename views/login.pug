extends layouts/login-layout.pug

block content
    .loginContainer
        h1 Login
        form(method="post")
            p.errorMessage #{errorMessage}
            input(type="text", name="logUsername", placeholder="Username (try: admin)", required="")
            input(type="password", name="logPassword", placeholder="Password (try: admin)", required="")
            input(type="submit", value="Login")

        a(href="/register") Need an account? Register here.
